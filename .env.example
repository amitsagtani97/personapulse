# Copy to .env for local use. Never commit the filled file.
PORT=4173
ZOOWORK_API_KEY=
# Use a model returned by ZooWork /models.
ZOOWORK_MODEL=litellm/gpt-6-astra
# Recommended for 100 personas: an already running agent with web_search/web_fetch.
ZOOWORK_AGENT_ID=
# Optional: defaults to the current public Managed Agents API gateway.
ZOOWORK_BASE_URL=
TAVILY_API_KEY=
# Optional: Band Agent API room for focus-group records.
BAND_API_KEY=
BAND_CHAT_ID=
BAND_OWNER_ID=
BAND_OWNER_HANDLE=
BAND_OWNER_NAME=
